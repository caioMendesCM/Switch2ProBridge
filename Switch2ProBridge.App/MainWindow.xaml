<Window x:Class="Switch2ProBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Switch2ProBridge.App"
        Title="Switch 2 Pro Bridge" Width="1040" Height="560" MinWidth="720" MinHeight="420"
        Background="#16171A" Foreground="#E6E8EB" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" Icon="app.ico">
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Status" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#9AA0A8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="420"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0" Style="{StaticResource Caption}" Text="Switch 2 Pro Controller"/>
        <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="Xbox 360 Controller (virtual)"/>

        <local:GamepadView x:Name="SwitchPad" Grid.Row="1" Grid.Column="0" PadStyle="Switch2Pro" Margin="8"/>
        <TextBlock x:Name="Arrow" Grid.Row="1" Grid.Column="1" Text="➜" FontSize="40" VerticalAlignment="Center"
                   Margin="12,0" Foreground="#3A3D43"/>
        <local:GamepadView x:Name="XboxPad" Grid.Row="1" Grid.Column="2" PadStyle="Xbox360" Margin="8"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse x:Name="SwitchDot" Width="10" Height="10" Margin="0,0,8,0" Fill="#6B7079"/>
                <TextBlock x:Name="SwitchStatus" Style="{StaticResource Status}" Text="Starting…"/>
            </StackPanel>
            <TextBlock x:Name="Battery" Style="{StaticResource Status}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse x:Name="XboxDot" Width="10" Height="10" Margin="0,0,8,0" Fill="#6B7079"/>
                <TextBlock x:Name="XboxStatus" Style="{StaticResource Status}" Text="Starting…"/>
            </StackPanel>
            <TextBlock x:Name="VigemHelp" Style="{StaticResource Status}" Margin="0,4,0,0" Visibility="Collapsed">
                <Hyperlink NavigateUri="https://github.com/nefarius/ViGEmBus/releases/latest" RequestNavigate="OpenLink"
                           Foreground="#4CC2FF">Download ViGEmBus</Hyperlink> and install it. The app picks it up automatically.
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
